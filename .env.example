# Copy this file to .env and fill in your own values. Never commit real keys.

# Claude
ANTHROPIC_API_KEY=

# PostgreSQL (for Neon, end the URL with ?sslmode=require)
DATABASE_URL=

# LangSmith (tracing, and API access when running the API locally)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=reseva
LANGSMITH_DEPLOYMENT_NAME=reseva

# URL of a deployed agent, used by the API when running locally
LANGGRAPH_API_URL=

# Resend (confirmation emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Reseva

# Optional
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_PER_MINUTE=20

# Production only (set in .env.production, not in your local .env)
# RESEVA_IN_PROCESS=1
